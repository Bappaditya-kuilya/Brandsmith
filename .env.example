# Copy to .env and fill in. Never commit real keys.
# Free keys (preferred):
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional paid fallback:
ANTHROPIC_API_KEY=
# auto | groq | gemini | anthropic | none
LLM_PROVIDER=auto
# Optional overrides:
# LLM_MAIN_MODEL=
# LLM_SMALL_MODEL=
# OPENAI_API_KEY=
# Local Postgres: bound to 127.0.0.1 only. Default password is brandsmith (local dev).
DB_URL=jdbc:postgresql://127.0.0.1:5432/brandsmith
DB_USER=brandsmith
DB_PASSWORD=brandsmith
POSTGRES_PASSWORD=brandsmith
