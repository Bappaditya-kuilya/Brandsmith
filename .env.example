# Copy to .env for local dev. All values shown are the application.yml defaults.

# LLM (LLM_PROVIDER: auto | groq | gemini | anthropic | openai)
LLM_PROVIDER=auto
LLM_TIMEOUT_MS=60000
LLM_MAIN_MODEL=
LLM_SMALL_MODEL=
LLM_MAIN_IN_PRICE=
LLM_MAIN_OUT_PRICE=
LLM_SMALL_IN_PRICE=
LLM_SMALL_OUT_PRICE=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (docker-compose defaults)
DB_URL=jdbc:postgresql://localhost:5432/brandsmith
DB_USER=brandsmith
DB_PASSWORD=brandsmith

# Server
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://brandsmith-seven.vercel.app,https://5173-01m17kk0ctxf49jxpa8svyymv9.cloudspaces.litng.ai
SESSION_TTL_DAYS=30

# Cookies: Secure flag, default on (set false only for plain-HTTP dev)
COOKIE_SECURE=true

# Budget / rate limit
BUDGET_CAP_USD=0.40
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL=10
